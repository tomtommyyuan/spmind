# =============================================================================
# SP-Mind Agent - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# Anthropic API (required)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key

# -----------------------------------------------------------------------------
# SP-Mind Configuration (optional)
# -----------------------------------------------------------------------------
# SPMIND_PATH=/path/to/working/directory
# SPMIND_LLM=claude-sonnet-4-5
# SPMIND_TEMPERATURE=1.0
# SPMIND_TIMEOUT_SECONDS=3600
# SPMIND_MEMORY_WINDOW_TURNS=10
# SPMIND_USE_TOOL_RETRIEVER=false

# Custom API endpoint (for proxy setups)
# SPMIND_CUSTOM_BASE_URL=http://your-proxy-url/v1
# SPMIND_CUSTOM_API_KEY=your-proxy-key

# -----------------------------------------------------------------------------
# Singularity Container Paths (for HPC environments)
# -----------------------------------------------------------------------------
# Set SIMG_DIR to where your .sif files are stored, then uncomment below.
# SIMG_DIR=/path/to/singularity/images
# ASHLAR_SIF=$SIMG_DIR/ashlar_latest.sif
# BASIC_ILLUMINATION_SIF=$SIMG_DIR/basic-illumination_latest.sif
# BACKGROUND_SUBTRACTION_SIF=$SIMG_DIR/background_subtraction_latest.sif
# UNETCOREOGRAPH_SIF=$SIMG_DIR/unetcoreograph_latest.sif
# UNMICST_SIF=$SIMG_DIR/unmicst_latest.sif
# S3SEGMENTER_SIF=$SIMG_DIR/s3segmenter_latest.sif
# MCQUANT_SIF=$SIMG_DIR/quantification_latest.sif
# SCIMAP_SIF=$SIMG_DIR/scimap_latest.sif
